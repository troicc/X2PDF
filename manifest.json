{
  "manifest_version": 3,
  "name": "X 长文导出 PDF",
  "version": "0.12.0",
  "description": "优先解析 X Article DraftJS，准确导出标题、代码、公式和媒体；支持代码高亮与一键复制、可选中公式、字体选项及 PDF 直接下载。",
  "minimum_chrome_version": "109",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "debugger",
    "downloads"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://www.x.com/*",
    "https://twitter.com/*",
    "https://www.twitter.com/*",
    "https://pbs.twimg.com/*",
    "https://abs.twimg.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "导出当前 X 长文"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
